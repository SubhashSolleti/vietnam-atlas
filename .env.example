# Vietnam Atlas: environment variables. Copy to .env.local for local work; set the same keys in Vercel.

# Postgres connection used by the app.
#  - Production (Vercel): Supabase "Transaction pooler" URI, port 6543 (Dashboard → Connect).
#  - Local development: Supabase, or a local Postgres from `npm run db:local`:
#    postgres://postgres:atlas-local@localhost:54329/atlas
DATABASE_URL=

# Optional: connection for migrations and seeding. Use Supabase's "Session pooler" URI (port 5432).
# Falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=

# Public base URL used for canonical links, the sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seeded staff accounts. Leave unset to have the seed generate strong passwords
# (printed once and saved to data/initial-credentials.txt). If set, use 12+ characters.
# SEED_ADMIN_PASSWORD=
# SEED_EDITOR_PASSWORD=

# Invite code for the seeded group trip (random when unset). Anyone with it can join that trip.
# DEMO_INVITE_CODE=

# Set to 1 behind a proxy that overwrites X-Forwarded-For (Vercel does). Enables per-IP rate limits.
# TRUST_PROXY=1

# Only for plain-http `next start` on a LAN: allow the session cookie without the Secure flag.
# INSECURE_COOKIES=1
