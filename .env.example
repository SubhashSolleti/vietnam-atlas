# Vietnam Atlas — environment variables (all optional for local use)

# SQLite database file (relative to the project root)
DATABASE_PATH=data/atlas.db

# Where admin image uploads are stored (outside public/; served by /media/uploads/*). Keep on persistent storage.
UPLOADS_DIR=data/uploads

# Public base URL used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seeded staff accounts. Leave unset to have `npm run db:reset` generate strong passwords
# (printed once and saved to data/initial-credentials.txt). If set, use 12+ characters.
# SEED_ADMIN_PASSWORD=
# SEED_EDITOR_PASSWORD=

# Invite code for the seeded group trip (random when unset). Anyone with it can join that trip.
# DEMO_INVITE_CODE=

# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For (enables per-IP rate limits).
# TRUST_PROXY=1

# Set to 1 only if you run `next start` over plain http on a LAN and need the session cookie without the Secure flag
# INSECURE_COOKIES=1
